---
interface ShowcaseImage {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  images: ShowcaseImage[];
  href: string;
}

const { title, images, href } = Astro.props;
const uid = `showcase-${title.toLowerCase().replace(/[^a-z0-9şğüıöç]/gi, '-')}`;
---

<section class="max-w-5xl mx-auto px-5 py-10">
  <div class="flex items-baseline justify-between mb-4">
    <h2 class="text-lg sm:text-xl tracking-wide font-light">{title}</h2>
    <a href={href} class="text-[13px] text-neutral-500 hover:text-neutral-900 transition-colors whitespace-nowrap ml-4">
      Daha fazlası →
    </a>
  </div>

  <a href={href} class="block">
    <div id={uid} class="relative w-full aspect-[4/5] sm:aspect-[16/9] overflow-hidden bg-neutral-100 rounded-sm">
      {images.map((img, i) => (
        <img
          src={img.src}
          alt={img.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          class="showcase-slide absolute inset-0 w-full h-full object-cover"
          style={`opacity:${i === 0 ? 1 : 0}`}
          data-index={i}
        />
      ))}
    </div>
  </a>
</section>

<script define:vars={{ uid, count: images.length }}>
  {
    const container = document.getElementById(uid);
    if (container && count > 1) {
      const slides = container.querySelectorAll('.showcase-slide');
      let current = 0;
      setInterval(() => {
        const next = (current + 1) % count;
        slides[current].style.transition = 'opacity 1.2s ease';
        slides[next].style.transition = 'opacity 1.2s ease';
        slides[current].style.opacity = '0';
        slides[next].style.opacity = '1';
        current = next;
      }, 4000);
    }
  }
</script>
