---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Uartm Studio' } = Astro.props;

const navItems = [
  { label: 'Hakkında', href: '/hakkinda' },
  { label: 'Duvar Resimleri', href: '/duvar-resimleri' },
  { label: 'Tablo', href: '/tablo' },
  { label: 'Kara Kalem', href: '/kara-kalem' },
  { label: 'Günlükler', href: '/gunlukler' },
  { label: 'Videolar', href: '/videolar' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Uartm Studio — Murat Apaydın. Duvar resimleri, tablolar ve kara kalem çalışmaları." />
    <title>{title} | Uartm Studio</title>
  </head>
  <body class="bg-white text-neutral-900 antialiased">
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-neutral-100">
      <div class="max-w-6xl mx-auto px-5 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo.jpeg" alt="Uartm Studio" class="h-9 w-auto" />
        </a>

        <button
          id="menu-toggle"
          aria-label="Menü"
          aria-expanded="false"
          class="p-2 -mr-2 flex flex-col justify-center gap-[5px] w-10 h-10"
        >
          <span class="block w-6 h-[1.5px] bg-neutral-900"></span>
          <span class="block w-6 h-[1.5px] bg-neutral-900"></span>
        </button>
      </div>
    </header>

    <div
      id="menu-overlay"
      class="fixed inset-0 z-40 bg-white translate-x-full transition-transform duration-300 ease-in-out"
    >
      <nav class="h-full flex flex-col items-center justify-center gap-6">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-2xl tracking-wide font-light transition-colors ${
              currentPath === item.href ? 'text-neutral-900 font-normal' : 'text-neutral-500 hover:text-neutral-900'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-5 py-10 mt-16 text-center text-[12px] text-neutral-400 border-t border-neutral-100">
      © {new Date().getFullYear()} Uartm Studio — Murat Apaydın
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const overlay = document.getElementById('menu-overlay');
      let open = false;
      toggle?.addEventListener('click', () => {
        open = !open;
        overlay?.classList.toggle('translate-x-full', !open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
