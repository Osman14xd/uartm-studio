---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Uartm Studio' } = Astro.props;

const navItems = [
  { label: 'Hakkında', href: '/hakkinda' },
  { label: 'Duvar Resmi & Mural', href: '/duvar-resimleri' },
  { label: 'Tablo', href: '/tablo' },
  { label: 'Kara Kalem', href: '/kara-kalem' },
  { label: 'Eskiz', href: '/eskiz' },
  { label: 'Günlükler', href: '/gunlukler' },
  { label: 'Videolar', href: '/videolar' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Uartm Studio — Murat Apaydın. Duvar resimleri, tablolar ve kara kalem çalışmaları." />
    <title>{title} | Uartm Studio</title>
    <!--
      Koyu tema, sayfa çizilmeden ÖNCE (head içinde, senkron) uygulanıyor ki
      "önce beyaz açılıp sonra koyuya dönme" (flash) yaşanmasın.
      Saat aralığı: 20:00 - 07:00 arası koyu tema.
    -->
    <script is:inline>
      (function () {
        var DARK_MODE_ENABLED = true;
        if (!DARK_MODE_ENABLED) return;
        var hour = new Date().getHours();
        var isNight = hour >= 20 || hour < 7;
        if (isNight) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="bg-white text-neutral-900 antialiased dark:bg-black dark:text-white transition-colors duration-300">
    <header class="sticky top-0 z-50 bg-white/95 dark:bg-black/95 backdrop-blur border-b border-neutral-100 dark:border-neutral-800 transition-colors duration-300">
      <div class="max-w-6xl mx-auto px-5 py-0 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo-light.png" alt="Uartm Studio" class="h-[3.33rem] w-auto block dark:hidden" />
          <img src="/images/logo-dark.png" alt="Uartm Studio" class="h-[3.33rem] w-auto hidden dark:block" />
        </a>

        <button
          id="menu-toggle"
          aria-label="Menü"
          aria-expanded="false"
          class="p-2 -mr-2 flex flex-col justify-center gap-[5px] w-10 h-10"
        >
          <span class="block w-6 h-[1.5px] bg-neutral-900 dark:bg-white"></span>
          <span class="block w-6 h-[1.5px] bg-neutral-900 dark:bg-white"></span>
        </button>
      </div>
    </header>

    <div
      id="menu-overlay"
      class="fixed inset-0 z-40 bg-white dark:bg-black translate-x-full transition-transform duration-300 ease-in-out"
    >
      <nav class="h-full flex flex-col items-center justify-center gap-6">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-2xl tracking-wide font-light transition-colors ${
              currentPath === item.href
                ? 'text-neutral-900 dark:text-white font-normal'
                : 'text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-5 py-10 mt-16 text-center text-[12px] text-neutral-400 dark:text-neutral-500 border-t border-neutral-100 dark:border-neutral-800">
      © {new Date().getFullYear()} Uartm Studio — Murat Apaydın
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const overlay = document.getElementById('menu-overlay');
      let open = false;
      toggle?.addEventListener('click', () => {
        open = !open;
        overlay?.classList.toggle('translate-x-full', !open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
