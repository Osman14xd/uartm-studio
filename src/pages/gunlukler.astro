---
import Layout from '../layouts/Layout.astro';
import ArtworkFeed from '../components/ArtworkFeed.astro';
import { gunlukler } from '../data/placeholder';
import { getEserlerByKategori, urlFor, fileUrlFor } from '../lib/sanity';

const sanityData = await getEserlerByKategori('gunlukler');
const items = sanityData.length > 0
  ? sanityData.map(e => ({
      images: e.gorseller.map((g: any) =>
        g._type === 'video'
          ? { src: fileUrlFor(g), alt: e.baslik, type: 'video' as const }
          : { src: urlFor(g).width(1200).url(), alt: e.baslik, type: 'image' as const }
      ),
      title: e.baslik,
      note: e.not || '',
    }))
  : gunlukler;
---

<Layout title="Günlükler">
  <div class="max-w-2xl mx-auto px-5 pt-8">
    <h1 class="text-xl font-light tracking-wide">Günlükler</h1>
    <p class="text-neutral-500 text-[13px] mt-1">Stüdyodan kısa notlar ve perde arkası</p>
  </div>
  <ArtworkFeed items={items} />
</Layout>
