---
import Layout from '../layouts/Layout.astro';
import { getSiteAyarlari } from '../lib/sanity';

const ayarlar = await getSiteAyarlari();
const metin = ayarlar?.hakkindaMetni;
---

<Layout title="Hakkında">
  <div class="max-w-xl mx-auto px-5 py-12">
    <h1 class="text-xl font-light tracking-wide mb-6">Hakkında</h1>
    <div class="text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300 space-y-4 whitespace-pre-line">
      {metin ? (
        <p>{metin}</p>
      ) : (
        <p class="text-neutral-400 dark:text-neutral-400 italic">
          Bu bölüme Murat'ın kendisi hakkında yazacağı metin gelecek — placeholder olarak duruyor.
        </p>
      )}
    </div>
  </div>
</Layout>
