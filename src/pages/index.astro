---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { duvarResimleri, tablolar, karaKalem } from '../data/placeholder';
import { getEserlerByKategori, getSiteAyarlari, urlFor } from '../lib/sanity';

// Sanity'den gerçek veriyi çekiyoruz. Murat henüz içerik yüklemediyse
// (veya build sırasında bağlantı sorunu olursa) placeholder veriye düşüyoruz,
// böylece site hiçbir zaman boş/kırık görünmüyor.
const [sanityDuvar, sanityTablo, sanityKaraKalem, ayarlar] = await Promise.all([
  getEserlerByKategori('duvar-resimleri'),
  getEserlerByKategori('tablo'),
  getEserlerByKategori('kara-kalem'),
  getSiteAyarlari(),
]);

const duvarList = sanityDuvar.length > 0
  ? sanityDuvar.map(e => ({ src: urlFor(e.gorsel).width(800).url(), alt: e.baslik, title: e.baslik }))
  : duvarResimleri;

const tabloList = sanityTablo.length > 0
  ? sanityTablo.map(e => ({ src: urlFor(e.gorsel).width(800).url(), alt: e.baslik, title: e.baslik }))
  : tablolar;

const karaKalemList = sanityKaraKalem.length > 0
  ? sanityKaraKalem.map(e => ({ src: urlFor(e.gorsel).width(800).url(), alt: e.baslik, title: e.baslik }))
  : karaKalem;

const whatsappNumber = ayarlar?.whatsapp || '905XXXXXXXXX';
const email = ayarlar?.email || 'info@uartmstudio.com';
const heroVideoUrl = ayarlar?.heroVideo?.asset?.url || '/videos/hero-placeholder.mp4';
const siluetUrl = ayarlar?.siluetFoto ? urlFor(ayarlar.siluetFoto).width(300).url() : '/images/silhouette.jpeg';
---

<Layout title="Ana Sayfa">
  <!--
    HERO VİDEO (siyah blok)
    Murat, Sanity panelinden "Site Ayarları > Ana Sayfa Videosu" alanına
    video yüklediğinde otomatik olarak burada gösterilir. Yüklemediyse
    geçici placeholder video devrede kalır.
  -->
  <section class="relative w-full h-[calc(100dvh-6rem)] bg-black overflow-hidden">
    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover">
      <source src={heroVideoUrl} type="video/mp4" />
    </video>
  </section>

  <!-- İLETİŞİM BLOĞU — pütürlü kağıt zemin, kesintisiz sayfa arka planı gibi -->
  <section class="paper-texture py-14">
    <div class="max-w-2xl mx-auto px-5 flex flex-col sm:flex-row items-center gap-6">
      <div class="w-28 h-28 flex-shrink-0 overflow-hidden rounded-full bg-white/50">
        <img
          src={siluetUrl}
          alt="Murat Apaydın"
          class="w-full h-full object-cover object-left"
        />
      </div>
      <div class="text-center sm:text-left">
        <h2 class="text-xl font-light tracking-wide">Murat Apaydın</h2>
        <p class="text-neutral-500 text-sm tracking-wide mt-0.5">Sanatçı</p>
        <div class="mt-4 space-y-1.5 text-[14px] text-neutral-700">
          <p>
            <a href={`https://wa.me/${whatsappNumber}`} class="hover:text-neutral-900 underline underline-offset-2">
              WhatsApp ile ulaş
            </a>
          </p>
          <p>
            <a href={`mailto:${email}`} class="hover:text-neutral-900 underline underline-offset-2">
              {email}
            </a>
          </p>
          <p>
            <a href="/hakkinda" class="hover:text-neutral-900 underline underline-offset-2">
              Daha fazlası →
            </a>
          </p>
        </div>
        <SocialLinks
          instagram={ayarlar?.instagram}
          twitter={ayarlar?.twitter}
          youtube={ayarlar?.youtube}
          tiktok={ayarlar?.tiktok}
        />
      </div>
    </div>

    <!-- ESKİZLER ŞERİDİ — sürekli otomatik kayan, aynı pütürlü zemin üzerinde devam ediyor -->
    <div class="mt-12">
      <Marquee title="Eskizler" images={karaKalemList.map(a => ({ src: a.src, alt: a.alt }))} href="/kara-kalem" speed={22} />
    </div>
  </section>

  <!-- 3 KATEGORİ KARTI — alt alta, Nike tarzı görsel+başlık+keşfet -->
  <section class="space-y-1">
    <CategoryCard
      image={duvarList[0].src}
      alt={duvarList[0].alt}
      categoryLabel="DUVAR RESİMLERİ"
      title={duvarList[0].title}
      href="/duvar-resimleri"
    />
    <CategoryCard
      image={tabloList[0].src}
      alt={tabloList[0].alt}
      categoryLabel="TABLOLAR"
      title={tabloList[0].title}
      href="/tablo"
    />
    <CategoryCard
      image={karaKalemList[0].src}
      alt={karaKalemList[0].alt}
      categoryLabel="ESKİZLER"
      title={karaKalemList[0].title}
      href="/kara-kalem"
    />
  </section>
</Layout>
