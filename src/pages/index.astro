---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { duvarResimleri, tablolar, karaKalem } from '../data/placeholder';
import { getEserlerByKategori, getSiteAyarlari, urlFor, fileUrlFor } from '../lib/sanity';

// Sanity'den gerçek veriyi çekiyoruz. Murat henüz içerik yüklemediyse
// (veya build sırasında bağlantı sorunu olursa) placeholder veriye düşüyoruz,
// böylece site hiçbir zaman boş/kırık görünmüyor.
const [sanityDuvar, sanityTablo, sanityKaraKalem, sanityEskiz, ayarlar] = await Promise.all([
  getEserlerByKategori('duvar-resimleri'),
  getEserlerByKategori('tablo'),
  getEserlerByKategori('kara-kalem'),
  getEserlerByKategori('eskiz'),
  getSiteAyarlari(),
]);

// Showcase/kart önizlemelerinde video değil, ilk FOTOĞRAFI göstermek istiyoruz
// (video otomatik oynamaz, boş kare gibi görünür). Yoksa yine de bir şey göstersin diye
// fallback olarak dizinin ilk öğesine düşüyoruz.
const ilkGorsel = (gorseller: any[]) => gorseller.find((g) => g._type !== 'video') || gorseller[0];

const duvarList = sanityDuvar.length > 0
  ? sanityDuvar.map(e => ({ src: urlFor(ilkGorsel(e.gorseller)).width(800).url(), alt: e.baslik, title: e.baslik }))
  : duvarResimleri.map(a => ({ src: a.images[0].src, alt: a.images[0].alt, title: a.title }));

const tabloList = sanityTablo.length > 0
  ? sanityTablo.map(e => ({ src: urlFor(ilkGorsel(e.gorseller)).width(800).url(), alt: e.baslik, title: e.baslik }))
  : tablolar.map(a => ({ src: a.images[0].src, alt: a.images[0].alt, title: a.title }));

const karaKalemList = sanityKaraKalem.length > 0
  ? sanityKaraKalem.map(e => ({ src: urlFor(ilkGorsel(e.gorseller)).width(800).url(), alt: e.baslik, title: e.baslik }))
  : karaKalem.map(a => ({ src: a.images[0].src, alt: a.images[0].alt, title: a.title }));

// Eskiz için placeholder YOK — Murat ilk eseri ekleyene kadar bu liste boş kalır
// ve ana sayfadaki 4. kart otomatik olarak gizli durur.
const eskizList = sanityEskiz.map(e => ({
  src: urlFor(ilkGorsel(e.gorseller)).width(800).url(),
  alt: e.baslik,
  title: e.baslik,
}));

const whatsappNumber = ayarlar?.whatsapp || '905XXXXXXXXX';
const email = ayarlar?.email || 'info@uartmstudio.com';
const heroVideoUrl = ayarlar?.heroVideo ? fileUrlFor(ayarlar.heroVideo) : '';
const heroVideoSrc = heroVideoUrl || '/videos/hero-placeholder.mp4';
const siluetUrl = ayarlar?.siluetFoto ? urlFor(ayarlar.siluetFoto).width(300).url() : '/images/silhouette.jpeg';
---

<Layout title="Murat Apaydın | Sanatçı">
  <!--
    HERO VİDEO (siyah blok)
    Murat, Sanity panelinden "Site Ayarları > Ana Sayfa Videosu" alanına
    video yüklediğinde otomatik olarak burada gösterilir. Yüklemediyse
    geçici placeholder video devrede kalır.
  -->
  <section class="relative w-full h-[calc(100dvh-3.33rem)] bg-black overflow-hidden">
    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover">
      <source src={heroVideoSrc} type="video/mp4" />
    </video>
  </section>

  <!-- İLETİŞİM BLOĞU — pütürlü kağıt zemin, kesintisiz sayfa arka planı gibi -->
  <section class="paper-texture py-14">
    <div class="max-w-2xl mx-auto px-5 flex flex-col sm:flex-row items-center gap-6">
      <div class="w-28 h-28 flex-shrink-0 overflow-hidden rounded-full bg-white/50">
        <img
          src={siluetUrl}
          alt="Murat Apaydın"
          class="w-full h-full object-cover object-left"
        />
      </div>
      <div class="text-center sm:text-left">
        <h2 class="text-xl font-light tracking-wide">Murat Apaydın</h2>
        <p class="text-neutral-500 dark:text-neutral-400 text-sm tracking-wide mt-0.5">Sanatçı</p>
        <div class="mt-4 space-y-1.5 text-[14px] text-neutral-700 dark:text-neutral-300">
          <p>
            <a href={`https://wa.me/${whatsappNumber}`} class="hover:text-neutral-900 dark:text-white dark:hover:text-neutral-300 underline underline-offset-2">
              WhatsApp ile ulaş
            </a>
          </p>
          <p>
            <a href={`mailto:${email}`} class="hover:text-neutral-900 dark:text-white dark:hover:text-neutral-300 underline underline-offset-2">
              {email}
            </a>
          </p>
          <p>
            <a href="/hakkinda" class="hover:text-neutral-900 dark:text-white dark:hover:text-neutral-300 underline underline-offset-2">
              Daha fazlası →
            </a>
          </p>
        </div>
        <SocialLinks
          instagram={ayarlar?.instagram}
          twitter={ayarlar?.twitter}
          youtube={ayarlar?.youtube}
          tiktok={ayarlar?.tiktok}
        />
      </div>
    </div>

    <!-- KARA KALEM ŞERİDİ — sürekli otomatik kayan, aynı pütürlü zemin üzerinde devam ediyor -->
    <div class="mt-12">
      <Marquee title="Kara Kalem" images={karaKalemList.map(a => ({ src: a.src, alt: a.alt }))} href="/kara-kalem" speed={22} />
    </div>
  </section>

  <!-- KATEGORİ KARTLARI — alt alta, her biri kendi içinde 3sn'de bir smooth geçişle proje değiştiriyor -->
  <section class="space-y-1">
    <CategoryCard
      items={duvarList.map(d => ({ image: d.src, alt: d.alt, title: d.title }))}
      categoryLabel="DUVAR RESMİ & MURAL"
      href="/duvar-resimleri"
    />
    <CategoryCard
      items={tabloList.map(d => ({ image: d.src, alt: d.alt, title: d.title }))}
      categoryLabel="TABLOLAR"
      href="/tablo"
    />
    <CategoryCard
      items={karaKalemList.map(d => ({ image: d.src, alt: d.alt, title: d.title }))}
      categoryLabel="KARA KALEM"
      href="/kara-kalem"
    />
    {eskizList.length > 0 && (
      <CategoryCard
        items={eskizList.map(d => ({ image: d.src, alt: d.alt, title: d.title }))}
        categoryLabel="ESKİZ"
        href="/eskiz"
      />
    )}
  </section>
</Layout>
