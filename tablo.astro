---
interface Props {
  image: string;
  alt: string;
  categoryLabel: string;
  title: string;
  href: string;
}

const { image, alt, categoryLabel, title, href } = Astro.props;
---

<a href={href} class="block relative w-full aspect-[4/5] sm:aspect-[16/10] overflow-hidden bg-neutral-900 group">
  <img
    src={image}
    alt={alt}
    loading="lazy"
    class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

  <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
    <p class="text-[12px] font-semibold tracking-wide text-white/90 mb-1">{categoryLabel}</p>
    <h3 class="text-xl sm:text-2xl font-bold text-white mb-4 max-w-md">{title}</h3>
    <span class="inline-block bg-white text-neutral-900 text-[13px] font-medium px-4 py-2 rounded-full">
      Keşfet
    </span>
  </div>
</a>
